{% if selected %}
<div class="layout layout--col layout--stretch">
  <div class="grid grid--cols-4 gap--medium w--full h--full">
    <div class="outline rounded p--3 col--span-1 lg:portrait:col--span-2 flex flex--col flex--between">
      <div class="w--full h--full rounded">
        <img class="image image--contain image-dither rounded w--full h--full" src="{{ selected.image_url_standard | default: selected.image_url }}" alt="{{ selected.image_alt }}">
      </div>
    </div>
    <div class="outline rounded p--3 col--span-3 lg:portrait:col--span-2 flex flex--col flex--between gap--small">
      <div class="flex flex--row flex--between flex--center-y gap--small">
        <span class="label lg:label--base">STILL HERE</span>
        <span class="label label--outline lg:label--base">{{ selected.status | upcase }}</span>
      </div>
      <span class="title {{ compact_name_size }}" data-clamp="2">{{ selected.name }}</span>
      <div class="divider"></div>
      <span class="description {{ compact_headline_size }} font--bold" data-clamp="3">{{ selected.headline }}</span>
      <div class="flex flex--col gap--xsmall">
        <span class="label label--small text--gray-30">WHY IT SURVIVES</span>
        <span class="description description--base" data-clamp="2">{{ selected.why_survives }}</span>
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <span class="title title--xlarge lg:title--xxlarge">No survivor data</span>
</div>
{% endif %}

<div class="title_bar">
  <span class="title flex flex--row flex--center-y gap--xsmall">{{ still_here_mark }} STILL HERE</span>
  <span class="instance">{% if selected %}{{ selected.timeline }} · {{ selected.category }}{% else %}Data unavailable{% endif %}</span>
</div>
